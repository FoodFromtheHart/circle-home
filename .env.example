# Configuration reference only. Inject values through the host; no dotenv loader.
HOST=0.0.0.0
NODE_ENV=production
# Keep the EXISTING Render disk path; do not change it during an upgrade.
CIRCLE_DATA_DIR=/absolute/existing/persistent/mount
# Set a unique random 32+ character value in Render secrets; never commit it.
CIRCLE_ADMIN_TOKEN=
CIRCLE_PUBLIC_ORIGIN=https://circle-home.onrender.com
CIRCLE_ORG_ID=circle
CIRCLE_ORG_NAME=CIRCLE
CIRCLE_REFRESH_SECONDS=900

CIRCLE_REGISTRY_ID=1pcF6-T6b85jXS6CJ525XzO-ALdqDEDEDE9dFOYZDJ4o
CIRCLE_FINANCIAL_ID=1meMGMy8CuJijIwJmzUp092ZNi1Myeq57EyKCV_x60SI
CIRCLE_FINANCIAL_ENTITY_ID=ENT-0101
# Explicit entity scope excludes the Registry's example/sample rows.
CIRCLE_ENTITY_IDS=ENT-0101,ENT-0102,ENT-0201,ENT-0202,ENT-0203,ENT-0204,ENT-0205,ENT-0206,ENT-0207,ENT-0208,ENT-0209
# Dedicated service-account JSON secret, shared as VIEWER on only the two sheets.
CIRCLE_GOOGLE_SERVICE_ACCOUNT_JSON=
# Enable each only AFTER its authenticated /test read passes in staging.
CIRCLE_REGISTRY_ENABLED=false
CIRCLE_FINANCIAL_ENABLED=false

# Independently link Gmail and Calendar in Systems & sources after hosting setup.
CIRCLE_GOOGLE_OAUTH_CLIENT_ID=
CIRCLE_GOOGLE_OAUTH_CLIENT_SECRET=
# Optional legacy token. New connections store encrypted tokens on the persistent disk.
CIRCLE_GOOGLE_OAUTH_REFRESH_TOKEN=
# Restrict every personal source read to this verified account.
CIRCLE_GOOGLE_EXPECTED_EMAIL=hart@bayberrygarden.com
# Generate 32 random bytes encoded as 64 hex characters; keep in Render secrets.
CIRCLE_GOOGLE_TOKEN_KEY=
# Explicit executive query, e.g. an approved Gmail label or scoped sender/project query.
CIRCLE_GMAIL_QUERY=
CIRCLE_CALENDAR_ID=hart@bayberrygarden.com
CIRCLE_GMAIL_ENABLED=false
CIRCLE_CALENDAR_ENABLED=false
